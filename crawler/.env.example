# ============================================
# OpenAI API 설정
# ============================================
OPENAI_API_KEY=sk-your-api-key-here

# LLM 모델 설정 (선택사항)
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# ============================================
# Database 설정 (기존 크롤러용)
# ============================================
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=portmatch
POSTGRES_USER=port
POSTGRES_PASSWORD=match

# ============================================
# 크롤링 설정
# ============================================
CRAWL_LIMIT=10
ID_MAPPING_FILE=company_id_mapping.json
